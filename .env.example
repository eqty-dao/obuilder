# =============================================================================
# EQTY Ownable Builder - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# All variables with (required) must be set for production
# Variables with (optional) have sensible defaults
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=development                    # production | staging | development | test

# -----------------------------------------------------------------------------
# EQTY / Base Blockchain Configuration
# -----------------------------------------------------------------------------
# Network selection
EQTY_NETWORK_TYPE=testnet               # mainnet | testnet
EQTY_USE_MAINNET=false                  # true for production

# RPC Endpoints (optional - defaults to public endpoints)
EQTY_RPC_MAINNET=https://mainnet.base.org
EQTY_RPC_TESTNET=https://sepolia.base.org

# Wallet Private Keys (required for signing transactions)
# Format: hex string WITHOUT 0x prefix
EQTY_PRIVATE_KEY_MAINNET=
EQTY_PRIVATE_KEY_TESTNET=

# Template costs in USD
EQTY_TEMPLATE_COSTSUSD_MAINNET=0.15
EQTY_TEMPLATE_COSTSUSD_TESTNET=0.15

# Relay server for message delivery
EQTY_RELAY_SERVER=

# Queue processing
EQTY_QUEUEING_ALLOWED_MAINNET=true
EQTY_QUEUEING_ALLOWED_TESTNET=true

# -----------------------------------------------------------------------------
# AWS S3 Configuration (required for production)
# -----------------------------------------------------------------------------
# Note: AWS credentials are typically set via AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY
# or via IAM roles when running on AWS infrastructure

# S3 Bucket Names
OBUILDER_BUCKET_LOGS=obuilder-logs
OWNABLE_BUCKET_QUEUE_MAINNET=obuilder-production
OWNABLE_BUCKET_QUEUE_TESTNET=obuilder-staging
PINATA_BUCKET_MAINNET=obuilder-pinata-mainnet
PINATA_BUCKET_TESTNET=obuilder-pinata-testnet
OWNABLES_BUCKET_MAINNET=obuilder-ownables-mainnet
OWNABLES_BUCKET_TESTNET=obuilder-ownables-testnet

# Local testing mode (bypasses S3)
LOCAL_TESTING=false

# -----------------------------------------------------------------------------
# Pinata IPFS Configuration (required)
# -----------------------------------------------------------------------------
PINATA_JWT=
PINATA_GATEWAY_URL=

# -----------------------------------------------------------------------------
# IPFS Configuration
# -----------------------------------------------------------------------------
IPFS_START=true

# -----------------------------------------------------------------------------
# Telegram Bot (optional - for notifications)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID_MAINNET=
TELEGRAM_CHANNEL_ID_TESTNET=

# -----------------------------------------------------------------------------
# CoinMarketCap API (optional - for price data)
# -----------------------------------------------------------------------------
COINMARKETCAP_API_KEY=

# -----------------------------------------------------------------------------
# EVM Multi-Chain Configuration
# -----------------------------------------------------------------------------
# OBridge wallet addresses
OBRIDGE_WALLET_ADDR_MAINNET=
OBRIDGE_WALLET_ADDR_TESTNET=

# Account mnemonics for multi-chain operations
ACCOUNT_MNEMONIC_MAINNET=
ACCOUNT_MNEMONIC_TESTNET=

# Alchemy API Keys (for RPC endpoints)
ARBITRUM_ALCHEMY_API_KEY=
POLYGON_ALCHEMY_API_KEY=
ETH_ALCHEMY_API_KEY=
BASE_ALCHEMY_API_KEY=

# NFT Contract Addresses per Chain
ETHEREUM_NFT_CONTRACT_ADDR_MAINNET=
ETHEREUM_NFT_CONTRACT_ADDR_TESTNET=
ARBITRUM_NFT_CONTRACT_ADDR_MAINNET=
ARBITRUM_NFT_CONTRACT_ADDR_TESTNET=
POLYGON_NFT_CONTRACT_ADDR_MAINNET=
POLYGON_NFT_CONTRACT_ADDR_TESTNET=
BASE_NFT_CONTRACT_ADDR_MAINNET=
BASE_NFT_CONTRACT_ADDR_TESTNET=

# -----------------------------------------------------------------------------
# Storage Paths (optional - defaults work for most setups)
# -----------------------------------------------------------------------------
PACKAGES_PATH=storage/packages
CHAINS_PATH=storage/chains
