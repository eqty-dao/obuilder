# ============================================
# Core Application Configuration
# ============================================
NODE_ENV=development
API_SECRET_KEY=your_api_secret_key_here

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# Network Configuration (mainnet/testnet)
# ============================================
EQTY_NETWORK_ID=mainnet
EQTY_TEMPLATE_COSTSUSD_MAINNET=1.00
EQTY_TEMPLATE_COSTSUSD_TESTNET=1.00
QUEUEING_ALLOWED_MAINNET=true
QUEUEING_ALLOWED_TESTNET=true
REQUIRE_PAYMENT_TESTNET=true

# ============================================
# Relay Server Configuration
# ============================================
RELAY_SERVER=https://relay-dev.lto.network
LOCAL_RELAY_SERVER=http://localhost:8000

# ============================================
# AWS S3 Configuration
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-west-1

# S3 Buckets
OBUILDER_BUCKET_LOGS=obuilder-logs
OWNABLE_BUCKET_QUEUE_MAINNET=obuilder-production
OWNABLE_BUCKET_QUEUE_TESTNET=obuilder-staging
PINATA_BUCKET_MAINNET=obuilder-pinata-mainnet
PINATA_BUCKET_TESTNET=obuilder-pinata-testnet
OWNABLES_BUCKET_MAINNET=obuilder-ownables-mainnet
OWNABLES_BUCKET_TESTNET=obuilder-ownables-testnet
LOCAL_TESTING=false

# ============================================
# Ethereum/Blockchain Configuration
# ============================================
# Mainnet
ACCOUNT_MNEMONIC_MAINNET=your_mainnet_mnemonic_phrase_here
OBRIDGE_WALLET_ADDR_MAINNET=0x0000000000000000000000000000000000000000
BASE_NFT_CONTRACT_ADDR_MAINNET=0x0000000000000000000000000000000000000000
ETHEREUM_NFT_CONTRACT_ADDR_MAINNET=0x0000000000000000000000000000000000000000
ARBITRUM_NFT_CONTRACT_ADDR_MAINNET=0x0000000000000000000000000000000000000000
POLYGON_NFT_CONTRACT_ADDR_MAINNET=0x0000000000000000000000000000000000000000

# Testnet
ACCOUNT_MNEMONIC_TESTNET=your_testnet_mnemonic_phrase_here
OBRIDGE_WALLET_ADDR_TESTNET=0x0000000000000000000000000000000000000000
BASE_NFT_CONTRACT_ADDR_TESTNET=0x0000000000000000000000000000000000000000
ETHEREUM_NFT_CONTRACT_ADDR_TESTNET=0x0000000000000000000000000000000000000000
ARBITRUM_NFT_CONTRACT_ADDR_TESTNET=0x0000000000000000000000000000000000000000
POLYGON_NFT_CONTRACT_ADDR_TESTNET=0x0000000000000000000000000000000000000000

# Alchemy API Keys
BASE_ALCHEMY_API_KEY=your_base_alchemy_api_key_here
ETH_ALCHEMY_API_KEY=your_eth_alchemy_api_key_here
ARBITRUM_ALCHEMY_API_KEY=your_arbitrum_alchemy_api_key_here
POLYGON_ALCHEMY_API_KEY=your_polygon_alchemy_api_key_here

# ============================================
# IPFS/Pinata Configuration
# ============================================
PINATA_JWT=your_pinata_jwt_token_here
PINATA_GATEWAY_URL=https://your-pinata-gateway.com
IPFS_START=false

# ============================================
# Storage Paths
# ============================================
PACKAGES_PATH=storage/packages
CHAINS_PATH=storage/chains

# ============================================
# External Services
# ============================================
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHANNEL_ID_MAINNET=your_mainnet_channel_id
TELEGRAM_CHANNEL_ID_TESTNET=your_testnet_channel_id