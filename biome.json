{
    "$schema": "https://biomejs.dev/schemas/1.5.0/schema.json",
    "organizeImports": {
        "enabled": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "correctness": {
                "noUnusedVariables": "error",
                "noUnusedImports": "error"
            },
            "suspicious": {
                "noExplicitAny": "warn",
                "noConsoleLog": "warn"
            },
            "style": {
                "noNonNullAssertion": "warn",
                "useConst": "error"
            },
            "complexity": {
                "noForEach": "off"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "tab",
        "indentWidth": 2,
        "lineWidth": 120
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all"
        }
    },
    "files": {
        "ignore": [
            "node_modules",
            "dist",
            "coverage",
            "*.spec.ts",
            "*.test.ts",
            "ownables",
            "storage",
            ".cargo",
            ".rustup"
        ]
    }
}