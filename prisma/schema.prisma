// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// For NEON.tech
// datasource db {
//   provider  = "postgresql"
//   url  	    = env("DATABASE_URL")
//   directUrl = env("DIRECT_URL")
// }

// For MYSQL local server
datasource db {
  provider  = "mysql"
  url  	    = env("DATABASE_URL")
}

model User {
  id          Int @id @default(autoincrement())
  name        String 
  email       String @unique
  walletAddr  String
  role  Role
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum Role {
  INTERN
  ENGINEER
  ADMIN
}

model UploadOwnableRequest {
  id            Int @id @default(autoincrement())
  zipFileName   String
  zipFileDir    String
  cid           String
  walletAddr    String
  ownableStatus OwnableStatus
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum OwnableStatus {
  ZIP_RECEIVED
  CREATING_OWNABLE
  OWNABLE_READY
}